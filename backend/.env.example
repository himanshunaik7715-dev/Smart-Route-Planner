# Smart Routing Planning System - backend environment variables (example only).
# Copy to your shell/host configuration. Never commit real values.

# Port the Spring Boot server listens on. Hosting platforms such as Render
# inject PORT automatically; 8080 is used locally when PORT is unset.
PORT=8080

# Comma-separated list of exact browser origins allowed to call the API.
# Local default: http://localhost:3000
# Production example: https://your-frontend.vercel.app
SRPS_CORS_ALLOWED_ORIGIN=http://localhost:3000
